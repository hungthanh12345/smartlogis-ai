# =============================================================================
# SMARTLOGIS AI - MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# =============================================================================
# Hướng dẫn sử dụng:
# 1. Sao chép file này thành .env:
#    Windows: copy .env.example .env
#    Linux/macOS: cp .env.example .env
# 2. Điền khóa bí mật và Google Gemini API Key của bạn trước khi chạy hệ thống.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. THÔNG TIN DỰ ÁN & MÔI TRƯỜNG VẬN HÀNH (APP & RUNTIME ENVIRONMENT)
# -----------------------------------------------------------------------------
PROJECT_NAME="SmartLogis AI - Hệ thống Quản lý Kho Thông minh Tích hợp AI"
VERSION="4.0.0"
ENVIRONMENT="development"
DEBUG=True

# -----------------------------------------------------------------------------
# 2. BẢO MẬT & XÁC THỰC NGƯỜI DÙNG (SECURITY, JWT & RBAC PERMISSIONS)
# -----------------------------------------------------------------------------
# Chuỗi khóa bí mật dùng để ký và xác thực JWT token (Hãy thay đổi trên Production!)
SECRET_KEY="your-super-secret-key-change-in-production"

# Thuật toán mã hóa chữ ký số JWT
ALGORITHM="HS256"

# Thời hạn sống của Access Token (phút, 1440 = 24 giờ)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# 3. THAM SỐ KẾT NỐI CƠ SỞ DỮ LIỆU (DATABASE CONNECTION PARAMETERS)
# -----------------------------------------------------------------------------
# CƠ CHẾ DUAL-DATABASE ARCHITECTURE:
# Lựa chọn 1: MySQL Server 8.0:
DATABASE_URL="mysql+pymysql://root:your_password@localhost:3306/smartlogis_db?charset=utf8mb4"

# Lựa chọn 2: SQLite (Mặc định dev nhẹ không cần server):
# DATABASE_URL="sqlite:///./smartlogis.db"

# Lựa chọn 3: PostgreSQL Localhost (Kiểm thử tải cao):
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/smartlogis_db"

# --- Tham số chi tiết kết nối Cơ sở Dữ liệu (Granular Parameters) ---
DB_TYPE="mysql"
DB_HOST="localhost"
DB_PORT=3306
DB_NAME="smartlogis_db"
DB_USER="root"
DB_PASSWORD="your_password"

# --- Tham số đồng bộ Docker Compose (PostgreSQL Container) ---
POSTGRES_DB="smartlogis_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
POSTGRES_PORT=5432

# --- Cấu hình Connection Pooling (Tối ưu hóa tải cao cho PostgreSQL) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=True

# -----------------------------------------------------------------------------
# 4. TÍCH HỢP TRÍ TUỆ NHÂN TẠO (GOOGLE GEMINI AI API KEYS & ENDPOINTS)
# -----------------------------------------------------------------------------
# Khóa API Google Gemini (Lấy miễn phí tại: https://aistudio.google.com/)
# Để trống nếu muốn chạy hoàn toàn bằng Local Grounded Fallback Engine nội bộ
GEMINI_API_KEY=""

# Điểm cuối REST API Google Gemini Generative Language
GEMINI_API_ENDPOINT="https://generativelanguage.googleapis.com/v1beta"

# Mô hình AI ưu tiên (Mặc định: gemini-2.0-flash / gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-2.0-flash"

# Mô hình AI dự phòng khi model chính quá tải
GEMINI_FALLBACK_MODEL="gemini-1.5-flash"

# Giới hạn thời gian chờ phản hồi AI (giây) & Số lần thử lại khi gặp lỗi
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# 5. ĐIỂM CUỐI DỊCH VỤ API & WEBSOCKET REALTIME (API & WEBSOCKET ENDPOINTS)
# -----------------------------------------------------------------------------
API_V1_STR="/api/v1"
API_DOCS_URL="/docs"
API_REDOC_URL="/redoc"
WEBSOCKET_ENDPOINT="/ws/inventory"

# -----------------------------------------------------------------------------
# 6. MÁY CHỦ WEB, NGINX GATEWAY & SSL (WEB SERVER & NETWORK GATEWAY)
# -----------------------------------------------------------------------------
APP_HOST="0.0.0.0"
APP_PORT=8000
BASE_URL="http://localhost:8000"
SERVER_DOMAIN="smartlogis-ai.com"
HTTP_PORT=80
HTTPS_PORT=443
SSL_CERT_PATH="./certbot/conf/live/smartlogis-ai.com/fullchain.pem"
SSL_KEY_PATH="./certbot/conf/live/smartlogis-ai.com/privkey.pem"

# -----------------------------------------------------------------------------
# 7. CÔNG CỤ QUẢN TRỊ CSDL TRỰC QUAN (PGADMIN 4 WEB UI)
# -----------------------------------------------------------------------------
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL="admin@smartlogis.vn"
PGADMIN_DEFAULT_PASSWORD="adminpassword"